 bool CClient::DummyAllowed() const
 {
 	return m_ServerCapabilities.m_AllowDummy;
 }
+
+void CClient::DummyDisconnect(int Dummy, const char *pReason)
+{
+	if(Dummy != 1)
+		return;
+	DummyDisconnect(pReason);
+}
+
+void CClient::DummyConnect(int Dummy)
+{
+	if(Dummy != 1)
+	{
+		log_warn("client", "Multi-dummy not supported upstream; only dummy 1 is available.");
+		return;
+	}
+	DummyConnect();
+}
+
+bool CClient::DummyConnected(int Dummy) const
+{
+	return Dummy == 1 && DummyConnected();
+}
+
+bool CClient::DummyConnecting(int Dummy) const
+{
+	return Dummy == 1 && DummyConnecting();
+}
+
+bool CClient::DummyConnectingDelayed(int Dummy) const
+{
+	return Dummy == 1 && DummyConnectingDelayed();
+}
+
+bool CClient::AnyDummyConnected() const
+{
+	return DummyConnected();
+}
+
+bool CClient::AnyDummyConnecting() const
+{
+	return DummyConnecting();
+}
+
+bool CClient::AnyDummyConnectingDelayed() const
+{
+	return DummyConnectingDelayed();
+}
 
