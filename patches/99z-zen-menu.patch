+// Shared layout walk for render + input.
+float CClickGui::ZenWalk(float wx, float wy, float ww, float headerH, float scroll, float bodyH, bool draw, float alpha)
+{
+	float y = wy + headerH - scroll;
+	float contentH = 0.0f;
+	for(int i = 0; i < s_ZenRowCount; i++)
+	{
+		ZenRow &row = s_ZenRows[i];
+		float rx, ry, rw, rh;
+		ZenRowRect(row, 0, wx, y, ww, Z_ROWH, rx, ry, rw, rh);
+		if(draw)
+		{
+			if(ry + rh >= wy + headerH && ry <= wy + headerH + bodyH)
+				ZenDrawRow(row, 0, rx, ry, rw, rh, alpha);
+		}
+		else
+			ZenHitRow(row, 0, rx, ry, rw, rh, i);
+		y += Z_ROWH;
+		contentH += Z_ROWH;
+		if(row.m_Kind == ZEN_EXPAND && row.m_pExpanded && *row.m_pExpanded)
+		{
+			for(int c = 0; c < row.m_nKids; c++)
+			{
+				ZenRow &kid = row.m_pKids[c];
+				ZenRowRect(kid, 1, wx, y, ww, Z_KIDH, rx, ry, rw, rh);
+				if(draw)
+				{
+					if(ry + rh >= wy + headerH && ry <= wy + headerH + bodyH)
+						ZenDrawRow(kid, 1, rx, ry, rw, rh, alpha);
+				}
+				else
+					ZenHitRow(kid, 1, rx, ry, rw, rh, i * 100 + c);
+				y += Z_KIDH;
+				contentH += Z_KIDH;
+			}
+		}
+	}
+	return contentH;
+}
+
+void CClickGui::ZenRender(float alpha)
+{
+	float wx, wy, ww, wh, headerH;
+	ZenWindowRect(wx, wy, ww, wh, headerH);
+	Graphics()->BlendNormal();
+	DrawRoundedRect(wx, wy, ww, wh, 14.0f, 15, ZCol(Z_COL_BG, alpha));
+	DrawText(wx + Z_PAD, wy + 15.0f, 20.0f, "Zenith", ZCol(Z_COL_TEXT, alpha));
+	DrawText(wx + ww - 34.0f, wy + 15.0f, 20.0f, "X", ZCol(Z_COL_DIM, alpha));
+	Graphics()->LinesBegin();
+	const IGraphics::CLineItem sep(wx + Z_PAD, wy + headerH, wx + ww - Z_PAD, wy + headerH);
+	Graphics()->SetColor(0.89f, 0.90f, 0.92f, alpha);
+	Graphics()->LinesDraw(&sep, 1);
+	Graphics()->LinesEnd();
+	const float bodyY = wy + headerH;
+	const float bodyH = wh - headerH;
+	ClipEnableVirtual(wx, bodyY, ww, bodyH);
+	float contentH = ZenWalk(wx, wy, ww, headerH, m_ZenScroll, bodyH, true, alpha);
+	Graphics()->ClipDisable();
+	if(contentH > bodyH)
+		m_ZenScrollMax = contentH - bodyH;
+	else
+	{
+		m_ZenScrollMax = 0.0f;
+		m_ZenScroll = 0.0f;
+	}
+}
+
+void CClickGui::ZenHitRow(ZenRow &row, int depth, float rx, float ry, float rw, float rh, int flatIdx)
+{
+	(void)row;
+	(void)depth;
+	if(m_ZenHitPos.x >= rx && m_ZenHitPos.x < rx + rw && m_ZenHitPos.y >= ry && m_ZenHitPos.y < ry + rh)
+		m_ZenHitIdx = flatIdx;
+}
+
+static ZenRow *ZenRowByFlat(int flatIdx)
+{
+	if(flatIdx < 0)
+		return nullptr;
+	if(flatIdx < 100)
+	{
+		if(flatIdx >= s_ZenRowCount)
+			return nullptr;
+		return &s_ZenRows[flatIdx];
+	}
+	int i = flatIdx / 100, c = flatIdx % 100;
+	if(i < 0 || i >= s_ZenRowCount)
+		return nullptr;
+	ZenRow &row = s_ZenRows[i];
+	if(row.m_Kind != ZEN_EXPAND || !row.m_pExpanded || !*row.m_pExpanded)
+		return nullptr;
+	if(c < 0 || c >= row.m_nKids)
+		return nullptr;
+	return &row.m_pKids[c];
+}
+
+void CClickGui::ZenApplySlider(ZenRow &row, float x)
+{
+	float wx, wy, ww, wh, headerH;
+	ZenWindowRect(wx, wy, ww, wh, headerH);
+	float rx = wx + Z_PAD, rw = ww - Z_PAD * 2.0f;
+	float pct = (x - rx) / rw;
+	if(pct < 0.0f)
+		pct = 0.0f;
+	if(pct > 1.0f)
+		pct = 1.0f;
+	if(row.m_pVal && row.m_VMax > row.m_VMin)
+	{
+		float raw = (float)row.m_VMin + pct * (float)(row.m_VMax - row.m_VMin);
+		int v = row.m_VMin + (int)(roundf((raw - (float)row.m_VMin) / (float)row.m_VStep) * (float)row.m_VStep);
+		if(v < row.m_VMin)
+			v = row.m_VMin;
+		if(v > row.m_VMax)
+			v = row.m_VMax;
+		*row.m_pVal = v;
+	}
+}
+
+void CClickGui::ZenActivate(ZenRow &row, float x)
+{
+	if(row.m_Kind == ZEN_TOGGLE)
+	{
+		if(row.m_pOn)
+			*row.m_pOn = (*row.m_pOn != 0) ? 0 : row.m_OnVal;
+	}
+	else if(row.m_Kind == ZEN_EXPAND)
+	{
+		float wx, wy, ww, wh, headerH;
+		ZenWindowRect(wx, wy, ww, wh, headerH);
+		if(x >= wx + ww - Z_PAD - ww * 0.25f)
+		{
+			if(row.m_pExpanded)
+				*row.m_pExpanded = !*row.m_pExpanded;
+		}
+		else if(row.m_pOn)
+			*row.m_pOn = (*row.m_pOn != 0) ? 0 : row.m_OnVal;
+	}
+	else if(row.m_Kind == ZEN_CYCLE)
+	{
+		if(row.m_pOpt && row.m_OptCount > 0)
+		{
+			int v = *row.m_pOpt + 1;
+			if(v < 0 || v >= row.m_OptCount)
+				v = 0;
+			*row.m_pOpt = v;
+		}
+	}
+	else if(row.m_Kind == ZEN_BUTTON)
+	{
+		if(row.m_Action == 0)
+		{
+			if(GameClient()->Client()->AnyDummyConnected())
+			{
+				for(int D = 1; D < MAX_DUMMIES; D++)
+					if(GameClient()->Client()->DummyConnected(D))
+						GameClient()->Client()->DummyDisconnect(D, nullptr);
+			}
+			else
+				GameClient()->Client()->DummyConnect(1);
+		}
+		else if(row.m_Action == 1)
+		{
+			g_Config.m_ClDummy = g_Config.m_ClDummy ? 0 : 1;
+		}
+	}
+}
+
+bool CClickGui::ZenDown(vec2 pos)
+{
+	m_ZenDown = true;
+	m_ZenDownMoved = false;
+	m_ZenDownPos = pos;
+	m_ZenDownIdx = -1;
+	m_ZenSliderDrag = -1;
+	float wx, wy, ww, wh, headerH;
+	ZenWindowRect(wx, wy, ww, wh, headerH);
+	if(pos.x >= wx + ww - 40.0f && pos.x < wx + ww - 4.0f && pos.y >= wy + 8.0f && pos.y < wy + headerH - 8.0f)
+	{
+		g_Config.m_ClClickGui = 0;
+		m_ZenDown = false;
+		return true;
+	}
+	if(pos.x >= wx && pos.x < wx + ww - 40.0f && pos.y >= wy && pos.y < wy + headerH)
+	{
+		m_ZenWinDrag = true;
+		m_ZenWinDragOff = pos - vec2(wx, wy);
+		return true;
+	}
+	m_ZenHitPos = pos;
+	m_ZenHitIdx = -1;
+	float bodyH = wh - headerH;
+	ZenWalk(wx, wy, ww, headerH, m_ZenScroll, bodyH, false, 1.0f);
+	if(m_ZenHitIdx >= 0)
+	{
+		ZenRow *pRow = ZenRowByFlat(m_ZenHitIdx);
+		if(pRow && pRow->m_Kind == ZEN_SLIDER)
+		{
+			m_ZenSliderDrag = m_ZenHitIdx;
+			ZenApplySlider(*pRow, pos.x);
+			return true;
+		}
+		m_ZenDownIdx = m_ZenHitIdx;
+		return true;
+	}
+	m_ZenDownIdx = -2;
+	return true;
+}
+
+void CClickGui::ZenMove(vec2 pos)
+{
+	if(m_ZenWinDrag)
+	{
+		m_ZenWinOff = m_ZenWinOff + (pos - m_ZenDownPos);
+		m_ZenDownPos = pos;
+		m_ZenDownMoved = true;
+		return;
+	}
+	if(m_ZenSliderDrag >= 0)
+	{
+		ZenRow *pRow = ZenRowByFlat(m_ZenSliderDrag);
+		if(pRow)
+			ZenApplySlider(*pRow, pos.x);
+		m_ZenDownMoved = true;
+		return;
+	}
+	if(m_ZenDown && !m_ZenDownMoved)
+	{
+		if(distance(pos, m_ZenDownPos) > 14.0f)
+		{
+			m_ZenDownMoved = true;
+			m_ZenDownIdx = -2;
+		}
+	}
+	if(m_ZenDownMoved && m_ZenDownIdx == -2)
+	{
+		m_ZenScroll -= pos.y - m_ZenDownPos.y;
+		if(m_ZenScroll < 0.0f)
+			m_ZenScroll = 0.0f;
+		if(m_ZenScroll > m_ZenScrollMax)
+			m_ZenScroll = m_ZenScrollMax;
+		m_ZenDownPos = pos;
+	}
+}
+
+void CClickGui::ZenUp(vec2 pos)
+{
+	if(m_ZenWinDrag)
+	{
+		m_ZenWinDrag = false;
+		m_ZenDown = false;
+		return;
+	}
+	if(m_ZenSliderDrag >= 0)
+	{
+		m_ZenSliderDrag = -1;
+		m_ZenDown = false;
+		return;
+	}
+	if(m_ZenDown && !m_ZenDownMoved && m_ZenDownIdx >= 0)
+	{
+		ZenRow *pRow = ZenRowByFlat(m_ZenDownIdx);
+		if(pRow)
+			ZenActivate(*pRow, pos.x);
+	}
+	m_ZenDown = false;
+	m_ZenDownIdx = -1;
+}
+
+bool CClickGui::ZenWheel(float dir)
+{
+	m_ZenScroll += dir * 40.0f;
+	if(m_ZenScroll < 0.0f)
+		m_ZenScroll = 0.0f;
+	if(m_ZenScroll > m_ZenScrollMax)
+		m_ZenScroll = m_ZenScrollMax;
+	return true;
+}
+
+bool CClickGui::ZenTouch(std::vector<IInput::CTouchFingerState> &vFingers)
+{
+	// Closed menu: don't claim touches (game needs them).
+	const bool isOpen = g_Config.m_ClClickGui != 0 || m_AnimProgress > 0.0f;
+	if(!isOpen)
+	{
+		m_ZenTouchDown = false;
+		m_ZenDown = false;
+		m_ZenSliderDrag = -1;
+		m_ZenWinDrag = false;
+		m_TouchActive = false;
+		return false;
+	}
+	bool wasDown = m_ZenTouchDown;
+	vec2 curPos = m_ZenTouchPos;
+	bool isDown = !vFingers.empty();
+	if(isDown)
