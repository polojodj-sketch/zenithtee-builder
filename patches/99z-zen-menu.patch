+void CClickGui::ZenRowRect(ZenRow &row, int depth, float wx, float y, float ww, float h, float &rx, float &ry, float &rw, float &rh)
+{
+	(void)row;
+	rx = wx + Z_PAD + (depth > 0 ? Z_INDENT : 0.0f);
+	rw = ww - Z_PAD * 2.0f - (depth > 0 ? Z_INDENT : 0.0f);
+	ry = y;
+	rh = h;
+}
