+void CClickGui::ZenWindowRect(float &outX, float &outY, float &outW, float &outH, float &outHeaderH)
+{
+	const float sw = VScreenWidth();
+	const float sh = VScreenHeight();
+	outW = sw - 60.0f;
+	if(outW > 560.0f)
+		outW = 560.0f;
+	if(outW < 280.0f)
+		outW = 280.0f;
+	outH = sh - 140.0f;
+	if(outH > 760.0f)
+		outH = 760.0f;
+	if(outH < 320.0f)
+		outH = 320.0f;
+	outX = (sw - outW) * 0.5f + m_ZenWinOff.x;
+	outY = (sh - outH) * 0.5f + m_ZenWinOff.y;
+	if(outX < 8.0f)
+		outX = 8.0f;
+	if(outY < 8.0f)
+		outY = 8.0f;
+	if(outX + outW > sw - 8.0f)
+		outX = sw - 8.0f - outW;
+	if(outY + outH > sh - 8.0f)
+		outY = sh - 8.0f - outH;
+	outHeaderH = 54.0f;
+}
