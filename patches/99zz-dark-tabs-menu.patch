+void CClickGui::ZenDrawAction(ZenRow &row, float rx, float ry, float rw, float rh, float alpha)
+{
+	const float midY = ry + rh * 0.5f;
+	const float cx = rx + rw;
+	char aBuf[64];
+	CGameClient *pGame = GameClient();
+	if(row.m_Kind == ZEN_TOGGLE)
+	{
+		const bool on = ZenActionOn(GameClient(), row);
+		const float tw = 44.0f, th = 24.0f;
+		const float tx = cx - tw, ty = midY - th * 0.5f;
+		DrawText(rx, midY - 8.5f, 17.0f, row.m_pName, ZCol(Z_COL_TEXT, alpha));
+		unsigned track = on ? (unsigned)m_AccentColorRGBA : Z_COL_TRACK;
+		DrawRoundedRect(tx, ty, tw, th, th * 0.5f, 15, ZCol(track, alpha));
+		const float kx = on ? tx + tw - 20.0f : tx + 2.0f;
+		DrawRoundedRect(kx, ty + 2.0f, 18.0f, 18.0f, 9.0f, 15, ZCol(0xffffffff, alpha));
+	}
+	else if(row.m_Kind == ZEN_CYCLE)
+	{
+		int idx = ZenActionOpt(GameClient(), row);
+		const char *pVal = "?";
+		if(row.m_Action == 101 && idx >= 0 && idx < 7)
+			pVal = s_ABWeapons[idx];
+		else if(row.m_Action == 107 && idx >= 0 && idx < 6)
+			pVal = s_TBWeapons[idx];
+		else if(row.m_Action == 109 && idx >= 0 && idx < 3)
+			pVal = s_TBTriggerModes[idx];
+		DrawText(rx, midY - 8.5f, 17.0f, row.m_pName, ZCol(Z_COL_TEXT, alpha));
+		const float tw = TextRender()->TextWidth(17.0f, pVal);
+		DrawText(cx - tw - 22.0f, midY - 8.5f, 17.0f, pVal, ZCol(Z_COL_DIM, alpha));
+		DrawText(cx - 14.0f, midY - 8.5f, 17.0f, ">", ZCol(Z_COL_DIM, alpha));
+		(void)pGame;
+	}
+	else if(row.m_Kind == ZEN_SLIDER)
+	{
+		int v = ZenActionVal(GameClient(), row);
+		str_format(aBuf, sizeof(aBuf), "%d", v);
+		DrawText(rx, ry + 4.0f, 15.0f, row.m_pName, ZCol(Z_COL_TEXT, alpha));
+		const float tw = TextRender()->TextWidth(15.0f, aBuf);
+		DrawText(cx - tw, ry + 4.0f, 15.0f, aBuf, ZCol(Z_COL_DIM, alpha));
+		const float tx = rx, tw2 = rw, ty = ry + rh - 16.0f;
+		DrawRoundedRect(tx, ty, tw2, 6.0f, 3.0f, 15, ZCol(Z_COL_TRACK, alpha));
+		float pct = 0.0f;
+		if(row.m_Action == 103)
+			pct = (float)(v - 1) / 359.0f;
+		else if(row.m_Action == 104)
+			pct = (float)(v - 1) / 1999.0f;
+		else if(row.m_Action == 113)
+			pct = (float)(v - 1) / 49.0f;
+		if(pct < 0.0f)
+			pct = 0.0f;
+		if(pct > 1.0f)
+			pct = 1.0f;
+		DrawRoundedRect(tx, ty, tw2 * pct, 6.0f, 3.0f, 15, ZCol((unsigned)m_AccentColorRGBA, alpha));
+		const float kx = tx + tw2 * pct - 9.0f;
+		DrawRoundedRect(kx, ty - 6.0f, 18.0f, 18.0f, 9.0f, 15, ZCol(0xffffffff, alpha));
+	}
+	else if(row.m_Kind == ZEN_BUTTON)
+	{
+		char aLbl[64];
+		const char *pLabel = ZenActionLabel(GameClient(), row, aLbl, sizeof(aLbl));
+		const float bw = rw * 0.7f;
+		const float bx = rx + (rw - bw) * 0.5f, by = midY - 17.0f;
+		DrawRoundedRect(bx, by, bw, 34.0f, 8.0f, 15, ZCol((unsigned)m_AccentColorRGBA, alpha));
+		const float tw = TextRender()->TextWidth(17.0f, pLabel);
+		DrawText(bx + (bw - tw) * 0.5f, midY - 8.5f, 17.0f, pLabel, ZCol(0xffffffff, alpha));
+	}
+}
+
+void CClickGui::ZenActivateAction(ZenRow &row)
+{
+	CGameClient *pGame = GameClient();
+	int w = 0;
+	switch(row.m_Action)
+	{
+	case 101: pGame->m_AimBot.m_AimBotSelectedWeapon = (pGame->m_AimBot.m_AimBotSelectedWeapon + 1) % CAimBot::NUM_WEAPONS_AIM; break;
+	case 102: { auto &s = ZenABSet(pGame, w); s.m_Enabled = !s.m_Enabled; break; }
+	case 105: { auto &s = ZenABSet(pGame, w); s.m_Silent = !s.m_Silent; break; }
+	case 106: { auto &s = ZenABSet(pGame, w); s.m_Predict = !s.m_Predict; break; }
+	case 107: pGame->m_AimBot.m_TriggerBotSelectedWeapon = (pGame->m_AimBot.m_TriggerBotSelectedWeapon + 1) % CAimBot::NUM_WEAPONS_TRIGGER; break;
+	case 108: { auto &s = ZenTBSet(pGame, w); s.m_Enabled = !s.m_Enabled; break; }
+	case 109: { auto &s = ZenTBSet(pGame, w); s.m_TriggerMode = (s.m_TriggerMode + 1) % 3; break; }
+	case 110: pGame->m_Tas.JoinLeavePlayground(); break;
+	case 111: pGame->m_Tas.TogglePlay(); break;
+	case 112: pGame->m_Tas.SetPaused(!pGame->m_Tas.Paused()); break;
+	case 114: pGame->m_Tas.StepForward(); break;
+	case 115: pGame->m_Tas.StepRewind(); break;
+	case 116: ZenPfToggle(pGame); break;
+	default: break;
+	}
+}
+
+void CClickGui::ZenApplySliderAction(ZenRow &row, float pct)
+{
+	CGameClient *pGame = GameClient();
+	int w = 0;
+	if(pct < 0.0f)
+		pct = 0.0f;
+	if(pct > 1.0f)
+		pct = 1.0f;
+	switch(row.m_Action)
+	{
+	case 103: ZenABSet(pGame, w).m_Fov = 1.0f + pct * 359.0f; break;
+	case 104: ZenABSet(pGame, w).m_Radius = 1.0f + pct * 1999.0f; break;
+	case 113: pGame->m_Tas.SetTps(1.0f + pct * 49.0f); break;
+	default: break;
+	}
+}
 
