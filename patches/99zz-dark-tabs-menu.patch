+static CAimBot::SWeaponSettings &ZenABSet(CGameClient *pGame, int &outW)
+{
+	CAimBot &ab = pGame->m_AimBot;
+	int w = ab.m_AimBotSelectedWeapon;
+	if(w < 0 || w >= CAimBot::NUM_WEAPONS_AIM)
+		w = 0;
+	outW = w;
+	return ab.m_AimBotWeapons[w];
+}
+
+static CAimBot::SWeaponSettings &ZenTBSet(CGameClient *pGame, int &outW)
+{
+	CAimBot &ab = pGame->m_AimBot;
+	int w = ab.m_TriggerBotSelectedWeapon;
+	if(w < 0 || w >= CAimBot::NUM_WEAPONS_TRIGGER)
+		w = 0;
+	outW = w;
+	return ab.m_TriggerBotWeapons[w];
+}
+
+static bool ZenActionOn(CGameClient *pGame, ZenRow &row)
+{
+	int w = 0;
+	switch(row.m_Action)
+	{
+	case 102: return ZenABSet(pGame, w).m_Enabled;
+	case 105: return ZenABSet(pGame, w).m_Silent;
+	case 106: return ZenABSet(pGame, w).m_Predict;
+	case 108: return ZenTBSet(pGame, w).m_Enabled;
+	case 112: return pGame->m_Tas.Paused();
+	default: return false;
+	}
+}
+
+static int ZenActionOpt(CGameClient *pGame, ZenRow &row)
+{
+	int w = 0;
+	switch(row.m_Action)
+	{
+	case 101:
+		w = pGame->m_AimBot.m_AimBotSelectedWeapon;
+		if(w < 0 || w >= CAimBot::NUM_WEAPONS_AIM)
+			w = 0;
+		return w;
+	case 107:
+		w = pGame->m_AimBot.m_TriggerBotSelectedWeapon;
+		if(w < 0 || w >= CAimBot::NUM_WEAPONS_TRIGGER)
+			w = 0;
+		return w;
+	case 109: return ZenTBSet(pGame, w).m_TriggerMode;
+	default: break;
+	}
+	return 0;
+}
+
+static int ZenActionVal(CGameClient *pGame, ZenRow &row)
+{
+	int w = 0;
+	switch(row.m_Action)
+	{
+	case 103: return (int)ZenABSet(pGame, w).m_Fov;
+	case 104: return (int)ZenABSet(pGame, w).m_Radius;
+	case 113: return (int)pGame->m_Tas.Tps();
+	default: return 0;
+	}
+}
+
+static const char *ZenActionLabel(CGameClient *pGame, ZenRow &row, char *pBuf, int BufSize)
+{
+	switch(row.m_Action)
+	{
+	case 110: return pGame->m_Tas.IsJoined() ? "Leave" : "Join";
+	case 111: return (pGame->m_Tas.IsPlaying() || pGame->m_Tas.IsRealPlaying()) ? "Stop" : "Play";
+	case 116:
+		if(pGame->m_BotNet.m_PfState == PF_STATE_IDLE)
+			return "Start";
+		return (pGame->m_BotNet.m_PfState == PF_STATE_RUNNING) ? "Stop" : "Reset";
+	default: break;
+	}
+	if(row.m_Kind == ZEN_BUTTON)
+	{
+		if(row.m_Action == 0)
+			return pGame->Client()->AnyDummyConnected() ? "Disconnect Dummy" : "Connect Dummy";
+		if(row.m_Action == 1)
+			return g_Config.m_ClDummy == 0 ? "Switch to Dummy" : "Switch to Main";
+		return row.m_pName;
+	}
+	str_format(pBuf, BufSize, "%s", row.m_pName);
+	return pBuf;
+}
+
+static void ZenPfToggle(CGameClient *pGame)
+{
+	CBotNet &bn = pGame->m_BotNet;
+	if(bn.m_PfState == PF_STATE_IDLE)
+	{
+		bn.m_PfState = PF_STATE_RUNNING;
+		bn.PfResetRun();
+	}
+	else if(bn.m_PfState == PF_STATE_RUNNING)
+	{
+		bn.m_PfState = PF_STATE_FINISHED;
+		bn.PfThreadStop();
+	}
+	else
+	{
+		bn.m_PfState = PF_STATE_IDLE;
+		bn.PfThreadStop();
+		std::lock_guard<std::mutex> lock(bn.m_PfDataMutex);
+		bn.m_PfVPath.clear();
+	}
+}
