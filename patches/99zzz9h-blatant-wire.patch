+// ---- Blatant beam-search wiring (blatant_avoid.cpp planner) ----
+// The planner works on lightweight AvoidState snapshots. Each step advances
+// ONE tick of the real client prediction from a saved full core, so hook /
+// freeze / teleport physics match the game exactly. Node states are full
+// CCharacterCore copies in a per-call pool (AvoidState.integers[0] is the
+// pool index); a single scratch world is reused because calls are sequential
+// and every step reloads its node's core first.
+struct BlatantNodeCore
+{
+	CCharacterCore m_Core;
+	int m_FreezeTime = 0;
+};
+
+struct BlatantCtx
+{
+	CGameWorld *m_pWorld = nullptr;
+	CCollision *m_pCol = nullptr;
+	int m_LocalId = -1;
+	CNetObj_PlayerInput m_BaseInput{};
+	std::vector<BlatantNodeCore> m_vCores;
+};
+
+static void BlatantFillState(const BlatantNodeCore &NC, bool Dead, CCharacter *pChar, CCollision *pCol, AvoidState &St)
+{
+	St.position = {NC.m_Core.m_Pos.x, NC.m_Core.m_Pos.y};
+	St.velocity = {NC.m_Core.m_Vel.x, NC.m_Core.m_Vel.y};
+	St.hookPosition = {NC.m_Core.m_HookPos.x, NC.m_Core.m_HookPos.y};
+	St.hookDirection = {NC.m_Core.m_HookDir.x, NC.m_Core.m_HookDir.y};
+	St.hookState = NC.m_Core.m_HookState;
+	St.jumped = NC.m_Core.m_Jumped;
+	St.frozen = NC.m_FreezeTime > 0;
+	St.dead = Dead;
+	St.hookedPlayer = -1;
+	if(!Dead && pChar)
+	{
+		St.grounded = pChar->IsGrounded();
+		const int Idx = pCol->GetPureMapIndex(pChar->Core()->m_Pos);
+		St.teleported = pCol->IsTeleport(Idx) || pCol->IsEvilTeleport(Idx);
+	}
+	else
+	{
+		St.grounded = false;
+		St.teleported = false;
+	}
+}
+
+static void BlatantStep(void *pCtx, AvoidState &St, const AvoidInput &In)
+{
+	BlatantCtx *pC = (BlatantCtx *)pCtx;
+	const BlatantNodeCore &NC = pC->m_vCores[(size_t)St.integers[0]];
+	CCharacter *pCh = pC->m_pWorld->GetCharacterById(pC->m_LocalId);
+	if(!pCh)
+	{
+		St.dead = true;
+		return;
+	}
+	pCh->SetCore(NC.m_Core);
+	pCh->m_FreezeTime = NC.m_FreezeTime;
+	CNetObj_PlayerInput Sim = pC->m_BaseInput;
+	Sim.m_Direction = In.direction;
+	Sim.m_Jump = In.jump;
+	Sim.m_Hook = In.hook;
+	Sim.m_TargetX = In.targetX;
+	Sim.m_TargetY = In.targetY;
+	pCh->OnDirectInput(&Sim);
+	pC->m_pWorld->m_GameTick = St.tick + 1;
+	pCh->OnPredictedInput(&Sim);
+	pC->m_pWorld->Tick();
+	CCharacter *pAfter = pC->m_pWorld->GetCharacterById(pC->m_LocalId);
+	if(!pAfter)
+	{
+		St.dead = true;
+		return;
+	}
+	BlatantNodeCore Out;
+	Out.m_Core = *pAfter->Core();
+	Out.m_FreezeTime = pAfter->m_FreezeTime;
+	pC->m_vCores.push_back(Out);
+	St.integers[0] = (int)pC->m_vCores.size() - 1;
+	BlatantFillState(Out, false, pAfter, pC->m_pCol, St);
+}
+
+static std::uint64_t BlatantClock(void *)
+{
+	return (std::uint64_t)time_get() * 1000000ULL / (std::uint64_t)time_freq();
+}
